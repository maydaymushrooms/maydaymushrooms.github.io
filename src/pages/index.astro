---
import Layout from '@layouts/Layout.astro';

import { Image } from 'astro:assets';

import WordmarkDesktop from '@assets/Wordmark-Desktop.svg';
import WordmarkMobile from '@assets/Wordmark-Mobile.svg';

import ImageLionsMane from '@assets/Asset-Mushroom-LionsMane.png';
import ImageOyster from '@assets/Asset-Mushroom-Oyster.png';
---

<Layout>
	<main>
		<section class="landing-section">
			<Image class="landing-image-lionsmane" src={ImageLionsMane} alt="a lion's mane mushroom" />
			<Image class="landing-image-oyster" src={ImageOyster} alt="an oyster mushroom" />
			<div class="wordmark-container">
				<WordmarkMobile class="wordmark-mobile"></WordmarkMobile>
				<WordmarkDesktop class="wordmark-desktop"></WordmarkDesktop>
			</div>
			<p>Coming soon.</p>
			<p>For inquiries:</p>
			<p class="contact italic">maydaymushrooms (at) <span>gmail.</span>proton.<span>com</span>me</p>
		</section>
		<footer>
			<p>May Day Mushrooms L.W.C.A. 2026</p>
		</footer>
	</main>
</Layout>

<style>


	main {
		height: 100%;
		width: 100%;
		display: grid;
		color: #111310;
		font-family: "Inter", sans-serif;
		font-optical-sizing: auto;
		font-weight: 300;
		font-style: normal;
	}

	.landing-image-lionsmane {
		display: block;
		position: absolute;
		width: 30vw;
		height: auto;
		right: 0;
		bottom: 0;
	}	

	.landing-image-oyster {
		display: block;
		position: absolute;
		width: 30vw;
		height: auto;
		left: 0;
		bottom: 0;
	}

	.wordmark-container {
		width: 30vw;
		max-height: 50vh;
	}

	.wordmark-desktop {
		display: none;
	}

	.wordmark-mobile {
		max-width: 100%;
		max-height: 100%;
	}

	.landing-section {
		display: grid;
		justify-items: center;
		text-align: center;
		align-self: center;
		justify-self: center;
		height: fit-content;
		width: fit-content;
	}

	.italic {
		font-style: italic;
	}

	.contact {
		margin-top: -0.6rem;
	}

	.contact > span {
		display: none;
	}

	footer {
		font-size: 0.7rem;
		position: fixed;
		bottom: 5px;
		left: 50%;
		transform: translateX(-50%);
		text-align: center;
	}
</style>